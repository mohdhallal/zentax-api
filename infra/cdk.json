{
  "app": "npx ts-node --prefer-ts-exts bin/zentax.ts",
  "watch": {
    "include": [
      "**"
    ],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "node_modules",
      "test"
    ]
  },
  "context": {
    "// split": "This app owns the shared foundations of a cell (ZenTax-<Env>-Network, -Data, -Cluster), the api service (ZenTax-<Env>-Api) and the account-level ZenTax-GithubOidc. The web tier (ZenTax-<Env>-Web, -Edge) is the UI repository's CDK app (zentax-ui/infra); the two meet only through the CloudFormation exports in lib/exports.ts.",
    "// deploy boundary": "Both environments live in this one account+region, so one CDK bootstrap (one CloudFormation execution role, scoped by ZenTaxCfnExecutionPolicy) deploys both. The GitHub deploy roles are per environment and per repository (zentax-deploy-<env>-api here, zentax-deploy-<env>-web for the UI repository), but the execution role is shared: real per-environment isolation of the deploy path needs one account per environment (README: 'Why staging and production share the deploy boundary today').",
    "// imageTag": "`cdk deploy --context imageTag=<sha>` (what the pipeline passes) overrides environments.<env>.imageTag.",
    "// dbBackupDays": "Also the documents bucket's non-current-version expiry: one retention window for a full restore (DB PITR + overwritten/deleted documents), ADR-0007 / ADR-0014.",
    "// ownsRdsOsMetricsLogGroup": "RDS enhanced monitoring writes to ONE `RDSOSMetrics` log group per account+region; the environment that owns it pre-creates it with its retention. Exactly one environment per account+region may be true, and it must be the environment deployed FIRST (RDS auto-creates the group without retention as soon as the first instance with enhanced monitoring exists, and CloudFormation cannot adopt it): staging today; both once they have separate accounts.",
    "// alarmEmail": "Optional per environment: an e-mail subscribed to the alarm topic (confirm the subscription mail after the first deploy). The UI app subscribes the same address to its Edge (us-east-1) topic.",
    "// corsAllowedOrigins": "Optional per environment: the api's CORS_ALLOWED_ORIGINS (comma-separated). The public origin is created by the UI app (the Web stack's zentax-<env>-cloudfront-url export, or the custom domain), so set it here once known and deploy Api. Until then a reserved https://zentax-<env>.invalid placeholder satisfies the api's fail-closed validation — the web tier proxies every browser call and strips Origin, so nothing depends on it.",
    "// githubRepositories": "No longer read: the deploy roles are one per repository AND environment, and the two repositories (mohdhallal/zentax-api -> zentax-deploy-<env>-api, mohdhallal/zentax-ui -> zentax-deploy-<env>-web) are constants in lib/github-oidc-stack.ts.",
    "// web-only keys": "webDesiredCount, originVerifyVersion, domainName/certificateArn/hostedZone*, maxUploadBytes belong to zentax-ui/infra/cdk.json; lib/config.ts refuses them here.",
    "account": "160117555326",
    "region": "eu-central-1",
    "environments": {
      "staging": {
        "account": "160117555326",
        "region": "eu-central-1",
        "cidr": "10.20.0.0/16",
        "dbInstanceClass": "t4g.small",
        "dbMultiAz": false,
        "dbBackupDays": 7,
        "dbAllocatedStorageGb": 20,
        "dbMaxAllocatedStorageGb": 100,
        "natGateways": 1,
        "apiDesiredCount": 1,
        "logRetentionDays": 30,
        "deletionProtection": false,
        "imageTag": "latest",
        "cpuArchitecture": "X86_64",
        "ownsRdsOsMetricsLogGroup": true
      },
      "production": {
        "account": "160117555326",
        "region": "eu-central-1",
        "cidr": "10.30.0.0/16",
        "dbInstanceClass": "t4g.medium",
        "dbMultiAz": true,
        "dbBackupDays": 35,
        "dbAllocatedStorageGb": 50,
        "dbMaxAllocatedStorageGb": 200,
        "natGateways": 2,
        "apiDesiredCount": 2,
        "logRetentionDays": 365,
        "deletionProtection": true,
        "imageTag": "latest",
        "cpuArchitecture": "X86_64",
        "ownsRdsOsMetricsLogGroup": false
      }
    },
    "@aws-cdk-containers/ecs-service-extensions:enableDefaultLogDriver": true,
    "@aws-cdk/aws-apigateway:authorizerChangeDeploymentLogicalId": true,
    "@aws-cdk/aws-apigateway:disableCloudWatchRole": true,
