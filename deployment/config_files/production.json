{
  "app": {
    "env": "production",
    "port": 3000,
    "internalPort": 3001
  },
  "server": {
    "readHeaderTimeoutMs": 10000,
    "writeTimeoutMs": 30000,
    "idleTimeoutMs": 120000,
    "shutdownTimeoutMs": 20000
  },
  "database": {
    "url": "",
    "poolMax": 20,
    "idleTimeoutMs": 30000,
    "connectionTimeoutMs": 5000,
    "connMaxLifetimeMs": 1800000
  },
  "cors": {
    "allowedOrigins": [],
    "allowedMethods": [
      "GET",
      "POST",
      "PUT",
      "PATCH",
      "DELETE",
      "OPTIONS"
    ],
    "allowedHeaders": [
      "Accept",
      "Authorization",
      "Content-Type",
      "X-CSRF-Token",
      "X-Request-Id"
    ],
    "exposedHeaders": [
      "Link",
      "X-Request-Id"
    ],
    "allowCredentials": true,
    "maxAgeSec": 600
  },
  "swagger": {
    "enabled": false,
    "title": "ZenTax API",
    "version": "1.0.0"
  },
  "metrics": {
    "enabled": true,
    "namespace": "zentax"
  },
  "log": {
    "level": "info",
    "format": "json"
  },
  "nexusInternalApi": {
    "baseUrl": "",
    "timeoutMs": 5000,
    "defaultRps": 1,
    "defaultKeyType": "DVS"
  },
  "auth": {
    "encryptionKey": "",
    "sessionCookieName": "zentax_session",
    "sessionCookieSecure": true,
    "sessionIdleTtlMinutes": 480,
    "sessionAbsoluteTtlHours": 720
  },
  "storage": {
    "driver": "s3",
    "maxUploadBytes": 26214400,
    "fs": {
      "root": "/var/lib/zentax/documents"
    },
    "s3": {
      "bucket": "",
      "region": "",
      "endpoint": "",
      "forcePathStyle": false
    }
  }
}
