{
  "app": {
    "env": "development",
    "port": 3000,
    "internalPort": 3001
  },
  "server": {
    "readHeaderTimeoutMs": 10000,
    "writeTimeoutMs": 30000,
    "idleTimeoutMs": 120000,
    "shutdownTimeoutMs": 10000
  },
  "database": {
    "url": "postgres://admin:secretgol@localhost:5432/golang-api?sslmode=disable",
    "poolMax": 10,
    "idleTimeoutMs": 30000,
    "connectionTimeoutMs": 2000,
    "connMaxLifetimeMs": 1800000
  },
  "cors": {
    "allowedOrigins": [
      "*"
    ],
    "allowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "OPTIONS"
    ],
    "allowedHeaders": [
      "Accept",
      "Authorization",
      "Content-Type",
      "X-CSRF-Token"
    ],
    "exposedHeaders": [
      "Link"
    ],
    "allowCredentials": false,
    "maxAgeSec": 300
  },
  "swagger": {
    "title": "Go API",
    "version": "1.0.0"
  },
  "metrics": {
    "enabled": true,
    "namespace": "go_api_boilerplate"
  },
  "log": {
    "level": "debug",
    "format": "text"
  },
  "nexusInternalApi": {
    "baseUrl": "http://localhost:8080",
    "timeoutMs": 5000,
    "defaultRps": 1,
    "defaultKeyType": "DVS"
  },
  "auth": {
    "encryptionKey": "emVudGF4LWRldi1lbmNyeXB0aW9uLWtleS0zMmJ5dGU=",
    "sessionCookieName": "zentax_session",
    "sessionCookieSecure": false,
    "sessionIdleTtlMinutes": 480,
    "sessionAbsoluteTtlHours": 720
  },
  "storage": {
    "driver": "fs",
    "maxUploadBytes": 26214400,
    "fs": {
      "root": "./var/documents"
    },
    "s3": {
      "bucket": "",
      "region": "",
      "endpoint": "",
      "forcePathStyle": false
    }
  }
}